<Page
    x:Class="Alejandria.Views.AltasModelosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Alejandria.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título + botón de añadir -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Seguimiento de Altas de Modelos"
                Style="{ThemeResource TitleTextBlockStyle}"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CardPrimaryActionButtonStyle}"
                Click="AddModelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Añadir modelo" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <!-- Tabla -->
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado de columnas -->
                <Grid
                    Grid.Row="0"
                    Padding="20,14"
                    ColumnSpacing="12"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Número" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Nombre de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Áreas" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Quién recibe" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="Fecha solicitud" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="6" Text="Quién mandó" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="7" Text="" />
                </Grid>

                <!-- Filas -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Records}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModelRecord">
                            <Grid Padding="20,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Id}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind NumeroModelo}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind NombreModelo}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind AreasAplicablesTexto}" ToolTipService.ToolTip="{x:Bind AreasAplicablesTexto}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind QuienRecibeDocumento}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind FechaSolicitudTexto}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind QuienMandoDocumento}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{x:Bind PuedeEditar, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="EditModelButton_Click"
                                        Tag="{x:Bind}">
                                        <TextBlock
                                            Text="Editar"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{x:Bind MostrarBotonDocumento, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{x:Bind NombreDocumentoMostrado}"
                                        Click="DocumentoButton_Click"
                                        Tag="{x:Bind}">
                                        <TextBlock
                                            Text="{x:Bind EtiquetaBotonDocumento}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{x:Bind PuedeReemplazarDocumento, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="Subir otro PDF en lugar del actual"
                                        Click="ReemplazarDocumentoButton_Click"
                                        Tag="{x:Bind}">
                                        <TextBlock
                                            Text="Reemplazar PDF"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                    <TextBlock
                                        Text="En Histórico — sin edición"
                                        FontSize="12"
                                        FontStyle="Italic"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind EsHistorico, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Mensaje cuando no hay registros todavía -->
                <TextBlock
                    Grid.Row="1"
                    Text="Todavía no hay altas registradas. Usa &quot;Añadir modelo&quot; para crear la primera."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="20,24,20,24"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.Records.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />
            </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
