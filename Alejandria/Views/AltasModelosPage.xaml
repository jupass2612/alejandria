<Page
    x:Class="Alejandria.Views.AltasModelosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Alejandria.Models"
    xmlns:controls="using:Alejandria.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título y botón -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Seguimiento de Altas de Modelos"
                Style="{ThemeResource TitleTextBlockStyle}"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CardPrimaryActionButtonStyle}"
                ToolTipService.ToolTip="Añadir modelo (Ctrl+N)"
                Click="AddModelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Añadir modelo" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <!-- Tabla -->
        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid
                    Grid.Row="0"
                    Padding="20,14"
                    ColumnSpacing="12"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Número" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Nombre de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Áreas" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Quién recibe" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="Solicitud" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="6" Text="Quién mandó" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="7" Text="" />
                </Grid>

                <!-- Filas -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Records}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModelRecord">
                            <Grid Padding="20,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Id}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind NumeroModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind NombreModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind NombreModelo}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind AreasAplicablesTexto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind AreasAplicablesTexto}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind QuienRecibeDocumento}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind QuienRecibeDocumento}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind FechaSolicitudTexto}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Bind QuienMandoDocumento}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind QuienMandoDocumento}" />

                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Ya en Histórico -->
                                    <Border
                                        Padding="8,2"
                                        CornerRadius="10"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        ToolTipService.ToolTip="Ya está en Histórico, no se puede editar"
                                        Visibility="{x:Bind EsHistorico, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,6"
                                        CornerRadius="8"
                                        ToolTipService.ToolTip="Acciones"
                                        AutomationProperties.Name="Acciones"
                                        Visibility="{x:Bind TieneAcciones, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem
                                                    Text="Editar"
                                                    Tag="{x:Bind}"
                                                    Click="EditModelButton_Click"
                                                    Visibility="{x:Bind PuedeEditar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Text="{x:Bind EtiquetaBotonDocumento}"
                                                    Tag="{x:Bind}"
                                                    Click="DocumentoButton_Click"
                                                    Visibility="{x:Bind MostrarBotonDocumento, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xEA90;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Text="Reemplazar PDF"
                                                    Tag="{x:Bind}"
                                                    Click="ReemplazarDocumentoButton_Click"
                                                    Visibility="{x:Bind PuedeReemplazarDocumento, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE898;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Cargando / sin altas -->
                <controls:EmptyState
                    Grid.Row="1"
                    Glyph="&#xE80F;"
                    Title="Todavía no hay altas registradas"
                    Message="Cuando llegue una solicitud de modelo nuevo, regístrala aquí con su PDF."
                    ActionText="Añadir modelo"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    ActionClick="AddModelButton_Click"
                    Visibility="{x:Bind ViewModel.MostrarEstadoVacio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
