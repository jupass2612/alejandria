<Page
    x:Class="Alejandria.Views.ModelConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Alejandria.Controls"
    xmlns:models="using:Alejandria.Models"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8"
                ToolTipService.ToolTip="Volver a Modelos">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel>
                <TextBlock Text="Configuración de modelo" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="HeaderSubtitleText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Selector de área: cada área tiene su propia configuración independiente -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="20"
            HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Área que se está configurando" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Cada área tiene su propia configuración de BD y Plataforma iMES, independiente de las demás."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AreaCombo"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        SelectionChanged="AreaCombo_SelectionChanged" />
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Estado del Documento" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Si queda pendiente a correcciones, en Histórico se habilita &quot;Adjuntar PDF&quot; para subir la versión corregida — no afecta el avance de esta área."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="EstadoDocumentoCombo"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.EstadoDocumentoOptions}"
                        SelectionChanged="StatusField_SelectionChanged" />
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{x:Bind ViewModel.ResumenFaltantesGlyph, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ResumenFaltantesTono, Mode=OneWay, Converter={StaticResource KpiTonoToBrushConverter}}"
                        FontSize="16"
                        VerticalAlignment="Top" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ResumenFaltantes, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ResumenFaltantesTono, Mode=OneWay, Converter={StaticResource KpiTonoToBrushConverter}}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Sugerencia: otra área con el mismo número de parte ya tiene configuración capturada -->
        <InfoBar
            x:Name="CopiarConfigInfoBar"
            Grid.Row="2"
            Margin="0,16,0,0"
            Severity="Informational"
            Title="Mismo número de parte en otra área"
            Message="{x:Bind ViewModel.MensajeConfigCopiable, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.TieneConfigCopiable, Mode=OneWay}"
            IsClosable="False">
            <InfoBar.ActionButton>
                <Button Content="Copiar configuración" Click="CopiarConfiguracionButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Resumen de estatus -->
        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="20"
            HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel Spacing="6">
                    <TextBlock Text="Estatus BD Consolidado" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:StatusBadge Status="{x:Bind ViewModel.EstatusBdConsolidado, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Estatus Plataforma iMES" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:StatusBadge Status="{x:Bind ViewModel.EstatusPlataformaImes, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Estatus General (área seleccionada)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:StatusBadge Status="{x:Bind ViewModel.EstatusGeneral, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Estatus General (modelo completo)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:StatusBadge Status="{x:Bind ViewModel.EstatusGeneralModelo, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Plazo (5 días hábiles)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.FechaLimiteTexto, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RetrasoTexto, Mode=OneWay}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppDangerBrush}"
                        Visibility="{x:Bind ViewModel.EstaAtrasado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RetrasoTexto, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.EstaAtrasado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,16,0,0" Spacing="8">
            <InfoBar
                Severity="Error"
                Title="Ocurrió un problema"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                x:Name="SuccessInfoBar"
                Severity="Success"
                Title="Listo"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                IsOpen="False"
                IsClosable="True" />
        </StackPanel>

        <ScrollViewer Grid.Row="5" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Config. Base de Datos - iMES -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Configuración Base de Datos — iMES" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <controls:StatusBadge x:Name="EstatusBdImesBadge" Grid.Column="1" Status="Pendiente" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="El estatus de arriba se calcula directo de los 3 pasos de abajo — Terminado cuando los 3 estén hechos."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <controls:ConfigurarEnImesControl x:Name="OracleWizard" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Probar un serial" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Corrobora que MODELS_SERIALNUMBERSPECS esté bien configurado — usa directo el serial de ejemplo que se capturó en el Paso 3 de arriba."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Serial a probar:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind OracleWizard.ViewModel.SerialEjemplo, Mode=OneWay}"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                Content="Probar"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.PuedeProbarSerial, Mode=OneWay}"
                                Click="ProbarSerialButton_Click" />
                            <InfoBar
                                x:Name="ResultadoSerialInfoBar"
                                Title="Resultado"
                                Message="{x:Bind ViewModel.ResultadoSerialMensaje, Mode=OneWay}"
                                IsOpen="{x:Bind ViewModel.TieneResultadoSerial, Mode=OneWay}"
                                IsClosable="True" />
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="4"
                                Visibility="{x:Bind ViewModel.ResultadoSerialEncontrado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PayloadSerial}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ImesCampoPayload">
                                            <Grid ColumnSpacing="16" Padding="12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Campo}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    FontFamily="Consolas"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Valor}"
                                                    Style="{ThemeResource BodyTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Configuracion Plataforma iMES -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Configuración Plataforma iMES" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource TableRowActionButtonStyle}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ImesApiDisponible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="BuscarEnImesButton_Click"
                            ToolTipService.ToolTip="Busca en iMES el Work Order, Ruta y Línea de esta área por su número de parte">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBuscandoImes, Mode=OneWay}" Width="12" Height="12" />
                                <TextBlock Text="Buscar en iMES" />
                            </StackPanel>
                        </Button>
                        <controls:StatusBadge Grid.Column="2" Status="{x:Bind ViewModel.EstatusPlataformaImes, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="Work Order, Ruta y Línea se llenan con &quot;Buscar en iMES&quot; — solo se pueden escribir a mano si esa búsqueda no encuentra nada (por ejemplo, si el Work Order todavía no está activo en iMES)."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <InfoBar
                        Title="Captura manual habilitada"
                        Message="No se encontró nada en iMES para esta área — revisa el mensaje de arriba y, si el Work Order no está activo todavía, puedes capturar estos 3 campos a mano mientras tanto."
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.PermiteCapturaManualPlataforma, Mode=OneWay}"
                        IsClosable="False" />

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Work Order" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="WorkOrderBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <!-- SMT le dice "Ruta" a este dato; BE y TLA le dicen "Flujo" al mismo ROUTE_NAME de iMES — solo se muestra el que aplica. -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.EsAreaSmt, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Ruta" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="RutaBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.EsAreaBeOTla, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Flujo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="FlujoBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Línea" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="LineaBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="PartLineBomMaintenance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="PartLineCombo" ItemsSource="{x:Bind ViewModel.PlataformaStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Guardar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,0,0,8">
                <TextBlock
                    x:Name="AutoguardadoText"
                    Text="Guardado"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Width="20" Height="20" />
                <Button
                    x:Name="SaveButton"
                    Content="Guardar configuración"
                    Style="{StaticResource CardPrimaryActionButtonStyle}"
                    Click="SaveButton_Click" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
