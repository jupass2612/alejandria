<Page
    x:Class="Alejandria.Views.ModelConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Alejandria.Controls"
    xmlns:models="using:Alejandria.Models"
    mc:Ignorable="d"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8"
                ToolTipService.ToolTip="Volver a Modelos">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel>
                <TextBlock Text="Configuración de modelo" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="HeaderSubtitleText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Franja de contexto: área, documento, plazo y estatus -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="20,16">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cada área tiene su propia configuración -->
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Área" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            x:Name="AreaCombo"
                            MinWidth="140"
                            ToolTipService.ToolTip="Cada área tiene su propia configuración de BD y Plataforma iMES"
                            SelectionChanged="AreaCombo_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Estado del documento" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            x:Name="EstadoDocumentoCombo"
                            MinWidth="200"
                            ItemsSource="{x:Bind ViewModel.EstadoDocumentoOptions}"
                            ToolTipService.ToolTip="Si queda pendiente a correcciones, en Histórico se habilita &quot;Adjuntar PDF&quot;. No afecta el avance."
                            SelectionChanged="StatusField_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="Plazo (5 días hábiles)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FechaLimiteTexto, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RetrasoTexto, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppDangerBrush}"
                            Visibility="{x:Bind ViewModel.EstaAtrasado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RetrasoTexto, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.EstaAtrasado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="Estatus del área" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:StatusBadge Status="{x:Bind ViewModel.EstatusGeneral, Mode=OneWay}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="Estatus del modelo" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:StatusBadge Status="{x:Bind ViewModel.EstatusGeneralModelo, Mode=OneWay}" HorizontalAlignment="Left" ToolTipService.ToolTip="Todas las áreas del modelo" />
                    </StackPanel>
                </Grid>

                <!-- Qué le falta a esta área -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{x:Bind ViewModel.ResumenFaltantesGlyph, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ResumenFaltantesTono, Mode=OneWay, Converter={StaticResource KpiTonoToBrushConverter}}"
                        FontSize="14"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ResumenFaltantes, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ResumenFaltantesTono, Mode=OneWay, Converter={StaticResource KpiTonoToBrushConverter}}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Sugerencia: otra área con el mismo número de parte ya tiene configuración capturada -->
        <InfoBar
            x:Name="CopiarConfigInfoBar"
            Grid.Row="2"
            Margin="0,12,0,0"
            Severity="Informational"
            Title="Mismo número de parte en otra área"
            Message="{x:Bind ViewModel.MensajeConfigCopiable, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.TieneConfigCopiable, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.TieneConfigCopiable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            IsClosable="False">
            <InfoBar.ActionButton>
                <Button Content="Copiar configuración" Click="CopiarConfiguracionButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>


        <StackPanel Grid.Row="4" Margin="0,16,0,0" Spacing="8">
            <InfoBar
                Severity="Error"
                Title="Ocurrió un problema"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                x:Name="SuccessInfoBar"
                Severity="Success"
                Title="Listo"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                IsOpen="False"
                IsClosable="True" />
        </StackPanel>

        <ScrollViewer x:Name="PasosScroll" Grid.Row="5" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Pasos -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="Paso1Button"
                        Grid.Column="0"
                        Tag="1"
                        Click="PasoButton_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10,12,0"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Paso 1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="MODELS_PARENTS" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <controls:StatusBadge Status="{x:Bind ViewModel.EstatusPaso1, Mode=OneWay}" HorizontalAlignment="Left" />
                            <Border Height="3" Margin="0,4,0,0" CornerRadius="2" Background="{ThemeResource AppAccentBrush}" Visibility="{x:Bind ViewModel.EsPaso1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="Paso2Button"
                        Grid.Column="1"
                        Tag="2"
                        Click="PasoButton_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10,12,0"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Paso 2" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="MODELS_MASTER" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <controls:StatusBadge Status="{x:Bind ViewModel.EstatusPaso2, Mode=OneWay}" HorizontalAlignment="Left" />
                            <Border Height="3" Margin="0,4,0,0" CornerRadius="2" Background="{ThemeResource AppAccentBrush}" Visibility="{x:Bind ViewModel.EsPaso2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="Paso3Button"
                        Grid.Column="2"
                        Tag="3"
                        Click="PasoButton_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10,12,0"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Paso 3" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="MODELS_SERIALNUMBERSPECS" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <controls:StatusBadge Status="{x:Bind ViewModel.EstatusPaso3, Mode=OneWay}" HorizontalAlignment="Left" />
                            <Border Height="3" Margin="0,4,0,0" CornerRadius="2" Background="{ThemeResource AppAccentBrush}" Visibility="{x:Bind ViewModel.EsPaso3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="Paso4Button"
                        Grid.Column="3"
                        Tag="4"
                        Click="PasoButton_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10,12,0"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Paso 4" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Plataforma iMES" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <controls:StatusBadge Status="{x:Bind ViewModel.EstatusPaso4, Mode=OneWay}" HorizontalAlignment="Left" />
                            <Border Height="3" Margin="0,4,0,0" CornerRadius="2" Background="{ThemeResource AppAccentBrush}" Visibility="{x:Bind ViewModel.EsPaso4, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Paso 1 · MODELS_PARENTS -->
            <Border
                Visibility="{x:Bind ViewModel.EsPaso1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Paso 1 · MODELS_PARENTS" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <controls:StatusBadge Grid.Column="1" Status="{x:Bind ViewModel.EstatusPaso1, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="Da de alta el modelo padre en iMES y marca quién lo hizo, o No Aplica si ya existía."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="¿Quién lo dio de alta?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="ParentsCombo" ItemsSource="{x:Bind ViewModel.BdStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Paso 2 · MODELS_MASTER -->
            <Border
                Visibility="{x:Bind ViewModel.EsPaso2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Paso 2 · MODELS_MASTER" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <controls:StatusBadge Grid.Column="1" Status="{x:Bind ViewModel.EstatusPaso2, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="Da de alta el número de parte en MODELS_MASTER ligado a su padre y marca quién lo hizo."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="¿Quién lo dio de alta?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="MasterCombo" ItemsSource="{x:Bind ViewModel.BdStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Paso 3 · MODELS_SERIALNUMBERSPECS -->
            <Border
                Visibility="{x:Bind ViewModel.EsPaso3, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Paso 3 · MODELS_SERIALNUMBERSPECS" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <controls:StatusBadge Grid.Column="1" Status="{x:Bind ViewModel.EstatusPaso3, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="Captura el serial de ejemplo, la plantilla del cliente y el MODELID. Revisa cómo queda la tabla, corre el INSERT en iMES y pruébalo."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- Datos para la vista previa -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Serial de ejemplo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SerialPruebaBox"
                                Grid.Column="0"
                                FontFamily="Consolas"
                                PlaceholderText="Serial de ejemplo"
                                Text="{x:Bind ViewModel.SerialPrueba, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Content="Extraer del PDF"
                                Click="ExtraerSerialDelPdfButton_Click"
                                ToolTipService.ToolTip="Saca el serial del &quot;Laser Serial Number real example&quot; del PDF adjunto" />
                        </Grid>
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Plantilla" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="PlantillaSpecsCombo"
                                ItemsSource="{x:Bind ViewModel.Plantillas}"
                                DisplayMemberPath="Nombre"
                                PlaceholderText="Tesla, GM..."
                                HorizontalAlignment="Stretch"
                                SelectionChanged="PlantillaSpecsCombo_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="MODELID" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                FontFamily="Consolas"
                                PlaceholderText="ID en MODELS_MASTER"
                                Text="{x:Bind ViewModel.ModelIdTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        Severity="Informational"
                        Message="{x:Bind ViewModel.PreviewSpecsMensaje, Mode=OneWay}"
                        IsOpen="{x:Bind ViewModel.TienePreviewSpecsMensaje, Mode=OneWay}"
                        IsClosable="False" />

                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Visibility="{x:Bind ViewModel.TienePreviewSpecs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid ColumnSpacing="12" Padding="12,10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VALUEDESCRIPTION" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="STARTPOSITION" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="EXPECTEDLEN" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="ISDYNAMIC" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="FIXEDCHARACTERVALUE" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewSpecs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SpecPreviewFila">
                                        <Grid ColumnSpacing="12" Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ValueDescription}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind StartTexto}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind LenTexto}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind DinamicoTexto}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind ValorTexto}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TieneSqlSpecs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="INSERT" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Copiar SQL" Style="{ThemeResource AccentButtonStyle}" Click="CopiarSqlSpecsButton_Click" />
                        </Grid>
                        <TextBox
                            Text="{x:Bind ViewModel.SqlSpecs, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            MaxHeight="280"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Probar en iMES -->
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Probar en iMES" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Ya con el INSERT corrido, prueba el mismo serial para ver que iMES lo reconozca."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                Content="Probar"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.PuedeProbarSerial, Mode=OneWay}"
                                Click="ProbarSerialButton_Click" />
                            <InfoBar
                                x:Name="ResultadoSerialInfoBar"
                                Title="Resultado"
                                Message="{x:Bind ViewModel.ResultadoSerialMensaje, Mode=OneWay}"
                                IsOpen="{x:Bind ViewModel.TieneResultadoSerial, Mode=OneWay}"
                                IsClosable="True" />
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="4"
                                Visibility="{x:Bind ViewModel.ResultadoSerialEncontrado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PayloadSerial}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ImesCampoPayload">
                                            <Grid ColumnSpacing="16" Padding="12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Campo}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    FontFamily="Consolas"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Valor}"
                                                    Style="{ThemeResource BodyTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Quién lo dio de alta -->
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="¿Quién lo dio de alta?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="MODELS_SERIALNUMBERSPECS" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="SerialSpecsCombo" ItemsSource="{x:Bind ViewModel.BdStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="MODELS_SERIALNUMBERSPECS Packing" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="SerialSpecsPackingCombo" ItemsSource="{x:Bind ViewModel.BdStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Visibility="{x:Bind ViewModel.EsPaso4, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Paso 4 · Plataforma iMES" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource TableRowActionButtonStyle}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ImesApiDisponible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="BuscarEnImesButton_Click"
                            ToolTipService.ToolTip="Busca en iMES el Work Order, Ruta y Línea de esta área por su número de parte">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBuscandoImes, Mode=OneWay}" Width="12" Height="12" />
                                <TextBlock Text="Buscar en iMES" />
                            </StackPanel>
                        </Button>
                        <controls:StatusBadge Grid.Column="2" Status="{x:Bind ViewModel.EstatusPaso4, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="Work Order, Ruta y Línea se llenan con &quot;Buscar en iMES&quot; — solo se pueden escribir a mano si esa búsqueda no encuentra nada (por ejemplo, si el Work Order todavía no está activo en iMES)."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <InfoBar
                        Title="Captura manual habilitada"
                        Message="No se encontró nada en iMES para esta área — revisa el mensaje de arriba y, si el Work Order no está activo todavía, puedes capturar estos 3 campos a mano mientras tanto."
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.PermiteCapturaManualPlataforma, Mode=OneWay}"
                        IsClosable="False" />

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Work Order" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="WorkOrderBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <!-- SMT le dice "Ruta" a este dato; BE y TLA le dicen "Flujo" al mismo ROUTE_NAME de iMES — solo se muestra el que aplica. -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.EsAreaSmt, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Ruta" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="RutaBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.EsAreaBeOTla, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Flujo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="FlujoBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Línea" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="LineaBox" IsReadOnly="{x:Bind ViewModel.CamposPlataformaSoloLectura, Mode=OneWay}" PlaceholderText="Usa &quot;Buscar en iMES&quot; arriba" TextChanged="TextField_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="PartLineBomMaintenance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="PartLineCombo" ItemsSource="{x:Bind ViewModel.PlataformaStatusOptions}" HorizontalAlignment="Stretch" SelectionChanged="StatusField_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Navegación y guardar -->
            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Click="AnteriorButton_Click" IsEnabled="{x:Bind ViewModel.PuedeAnterior, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="Anterior" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="SiguienteButton_Click"
                        Visibility="{x:Bind ViewModel.PuedeSiguiente, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Siguiente" />
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        x:Name="AutoguardadoText"
                        Text="Guardado"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Width="20" Height="20" />
                    <Button
                        x:Name="SaveButton"
                        Content="Guardar configuración"
                        Style="{StaticResource CardPrimaryActionButtonStyle}"
                        Click="SaveButton_Click" />
                </StackPanel>
            </Grid>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
