<Page
    x:Class="Alejandria.Views.EstadisticasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Alejandria.ViewModels"
    xmlns:models="using:Alejandria.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Estadísticas" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Avance general de Altas de Modelos: cuántos hay, en qué estatus están y quién ha hecho las configuraciones."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <InfoBar
            x:Name="ReportInfoBar"
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Success"
            Title="Listo"
            Message="{x:Bind ViewModel.ReportMessage, Mode=OneWay}"
            IsOpen="False"
            IsClosable="True">
            <InfoBar.ActionButton>
                <Button
                    Content="Abrir reporte"
                    Visibility="{x:Bind ViewModel.TieneReporteGenerado, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="AbrirReporteButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">

                <!-- KPIs -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Kpis}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="220"
                            MinItemHeight="112"
                            MinRowSpacing="16"
                            MinColumnSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:KpiItem">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock
                                            Text="{x:Bind Value}"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Foreground="{x:Bind Tono, Converter={StaticResource KpiTonoToBrushConverter}}"
                                            Visibility="{x:Bind TieneTono, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind Value}"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Visibility="{x:Bind TieneTono, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                    <TextBlock
                                        Text="{x:Bind Label}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Reportes -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Reportes" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Exporta los datos actuales a Excel, o genera un reporte en PDF con el detalle de qué se configuró en cada modelo."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <RadioButtons x:Name="AlcanceRadioButtons" SelectedIndex="0" SelectionChanged="AlcanceRadioButtons_SelectionChanged">
                                <RadioButton Content="Reporte general (todos los modelos en Histórico)" />
                                <RadioButton Content="Reporte especializado (elige uno o varios modelos)" />
                            </RadioButtons>

                            <StackPanel x:Name="EspecializadoPanel" Spacing="10" Visibility="Collapsed">
                                <TextBox
                                    x:Name="BusquedaModeloBox"
                                    PlaceholderText="Buscar en Histórico por nombre de modelo o número de parte (SMT/BE/TLA)..."
                                    MaxWidth="460"
                                    HorizontalAlignment="Left"
                                    TextChanged="BusquedaModeloBox_TextChanged" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.SugerenciasBusqueda, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ModelRecord">
                                            <Button
                                                Style="{StaticResource TableRowActionButtonStyle}"
                                                HorizontalContentAlignment="Left"
                                                HorizontalAlignment="Left"
                                                Click="AgregarSugerenciaButton_Click"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                    <TextBlock Text="{x:Bind NumeroModelo}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind NombreModelo}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="Modelos seleccionados para este reporte"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="Todavía no has agregado ningún modelo. Búscalo arriba y haz clic para agregarlo."
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontStyle="Italic"
                                        Visibility="{x:Bind ViewModel.ModelosSeleccionados.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ModelosSeleccionados, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModelRecord">
                                                <Border
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource InputCornerRadius}"
                                                    Padding="12,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{x:Bind NumeroModelo}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind NombreModelo}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Button
                                                            Content="Quitar"
                                                            Style="{StaticResource TableRowActionButtonStyle}"
                                                            Margin="12,0,0,0"
                                                            Click="QuitarSeleccionadoButton_Click"
                                                            Tag="{x:Bind}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Padding="18,10"
                                CornerRadius="8"
                                FontSize="14"
                                Style="{StaticResource CardPrimaryActionButtonStyle}"
                                Click="ExportarExcelButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Image x:Name="ExcelButtonLogo" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a Excel" VerticalAlignment="Center" />
                                    <ProgressRing
                                        IsActive="{x:Bind ViewModel.IsExportingExcel, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsExportingExcel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button
                                Padding="18,10"
                                CornerRadius="8"
                                FontSize="14"
                                Style="{StaticResource CardActionButtonStyle}"
                                Click="GenerarPdfButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Image x:Name="PdfButtonLogo" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Generar reporte PDF" VerticalAlignment="Center" />
                                    <ProgressRing
                                        IsActive="{x:Bind ViewModel.IsExportingPdf, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsExportingPdf, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quién ha hecho las configuraciones -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Quién ha hecho las configuraciones" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Cuenta cada una de las 5 tablas/campos de estatus (BD iMES, Flujo, PartLineBomMaintenance) que quedaron marcadas a nombre de cada persona, sumando todos los modelos."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Responsables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResponsableResumenItem">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Nombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="{x:Bind Proporcion}"
                                            VerticalAlignment="Center"
                                            Height="8" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind TareasCompletadas}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
