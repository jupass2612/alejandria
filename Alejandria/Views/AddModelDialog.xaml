<ContentDialog
    x:Class="Alejandria.Views.AddModelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Añadir modelo"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="380" MaxWidth="440">
        <InfoBar
            x:Name="ValidationInfoBar"
            Severity="Error"
            Title="Faltan datos"
            Message="El nombre de modelo, al menos un número de parte (SMT/BE/TLA), y quién recibe el documento son obligatorios."
            IsOpen="False"
            IsClosable="False" />

        <InfoBar
            x:Name="DuplicadoInfoBar"
            Severity="Warning"
            Title="Este número de parte ya existe"
            IsOpen="False"
            IsClosable="False" />

        <TextBox x:Name="NombreModeloBox" Header="Nombre de modelo" PlaceholderText="Ej. Charport Controller" />

        <StackPanel Spacing="8">
            <TextBlock
                Text="Número de parte por área (déjalo vacío si no aplica)"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="NumeroParteSmtBox" Header="SMT" />
            <StackPanel Spacing="4">
                <TextBox x:Name="NumeroParteBeBox" Header="BE" />
                <CheckBox
                    x:Name="BeMismoQueSmtCheck"
                    Content="Es el mismo número que SMT"
                    Checked="BeMismoQueSmtCheck_Checked"
                    Unchecked="BeMismoQueSmtCheck_Unchecked" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBox x:Name="NumeroParteTlaBox" Header="TLA" />
                <CheckBox
                    x:Name="TlaMismoQueSmtCheck"
                    Content="Es el mismo número que SMT"
                    Checked="TlaMismoQueSmtCheck_Checked"
                    Unchecked="TlaMismoQueSmtCheck_Unchecked" />
            </StackPanel>
        </StackPanel>

        <ComboBox
            x:Name="QuienRecibeBox"
            Header="Quién recibe el documento"
            PlaceholderText="Selecciona una persona"
            HorizontalAlignment="Stretch" />
        <DatePicker x:Name="FechaSolicitudPicker" Header="Fecha de solicitud" />
        <TextBox x:Name="QuienMandaBox" Header="Quién mandó el documento" PlaceholderText="Nombre de quien envía" />
    </StackPanel>
</ContentDialog>
