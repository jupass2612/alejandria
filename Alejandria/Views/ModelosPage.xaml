<Page
    x:Class="Alejandria.Views.ModelosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Alejandria.ViewModels"
    xmlns:controls="using:Alejandria.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Modelos" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Configuración de base de datos (iMES) y de Plataforma iMES por modelo registrado."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid
                    Grid.Row="0"
                    Padding="20,14"
                    ColumnSpacing="12"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Número de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Nombre de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Estatus General" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Plazo (5 días hábiles)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="" />
                </Grid>

                <!-- Filas -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Modelos}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeloResumenItem">
                            <Grid Padding="20,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Modelo.NumeroModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Modelo.NombreModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <controls:StatusBadge Grid.Column="2" Status="{x:Bind EstatusGeneral}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FechaLimiteTexto}" FontSize="12" />
                                    <TextBlock
                                        Text="{x:Bind RetrasoTexto}"
                                        FontSize="12"
                                        Foreground="{ThemeResource AppDangerBrush}"
                                        FontWeight="SemiBold"
                                        Visibility="{x:Bind EstaAtrasado, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Text="{x:Bind RetrasoTexto}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind EstaAtrasado, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="4"
                                    Content="Configurar"
                                    Style="{StaticResource TableRowActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="ConfigurarButton_Click"
                                    Tag="{x:Bind Modelo}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    Grid.Row="1"
                    Text="Todavía no hay modelos registrados. Agrégalos primero en &quot;Altas de Modelos&quot;."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="20,24,20,24"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.Modelos.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />
            </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
