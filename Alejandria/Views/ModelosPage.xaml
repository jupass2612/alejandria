<Page
    x:Class="Alejandria.Views.ModelosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Alejandria.ViewModels"
    xmlns:controls="using:Alejandria.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="BuscarAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Modelos" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind ViewModel.ConteoTexto, Mode=OneWay}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            IsClosable="False" />

        <!-- Buscador y filtros -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="BuscarBox"
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, número de modelo o número de parte (Ctrl+F)"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.Busqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <SelectorBar
                x:Name="FiltroBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                SelectionChanged="FiltroBar_SelectionChanged">
                <SelectorBarItem Text="Todos" Tag="Todos" IsSelected="True" />
                <SelectorBarItem Text="Pendientes" Tag="Pendientes" />
                <SelectorBarItem Text="En proceso" Tag="En proceso" />
                <SelectorBarItem Text="Atrasados" Tag="Atrasados" />
            </SelectorBar>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid
                    Grid.Row="0"
                    Padding="20,14"
                    ColumnSpacing="12"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Número de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Nombre de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Estatus" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Avance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Plazo (5 días hábiles)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="" />
                </Grid>

                <!-- Filas -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Modelos}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="ModelosList_ItemClick">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeloResumenItem">
                            <Grid Padding="20,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Modelo.NumeroModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Modelo.NombreModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Modelo.NombreModelo}" />
                                <controls:StatusBadge Grid.Column="2" Status="{x:Bind EstatusGeneral}" VerticalAlignment="Center" />

                                <!-- Un punto por paso -->
                                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind AvanceTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind EstatusPaso1, Converter={StaticResource StatusToBrushConverter}}" />
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind EstatusPaso2, Converter={StaticResource StatusToBrushConverter}}" />
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind EstatusPaso3, Converter={StaticResource StatusToBrushConverter}}" />
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind EstatusPaso4, Converter={StaticResource StatusToBrushConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AvanceTexto}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FechaLimiteTexto}" FontSize="12" />
                                    <TextBlock
                                        Text="{x:Bind RetrasoTexto}"
                                        FontSize="12"
                                        Foreground="{ThemeResource AppDangerBrush}"
                                        FontWeight="SemiBold"
                                        Visibility="{x:Bind EstaAtrasado, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Text="{x:Bind RetrasoTexto}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind EstaAtrasado, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="5"
                                    Content="Configurar"
                                    Style="{StaticResource TableRowActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="ConfigurarButton_Click"
                                    Tag="{x:Bind Modelo}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Cargando / sin modelos -->
                <controls:EmptyState
                    Grid.Row="1"
                    Glyph="&#xE8A5;"
                    Title="No hay modelos pendientes"
                    Message="Los modelos aparecen aquí en cuanto se dan de alta, y se van a Histórico cuando se terminan."
                    ActionText="Ir a Altas de Modelos"
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    ActionClick="IrAAltas_Click"
                    Visibility="{x:Bind ViewModel.MostrarEstadoVacio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- El filtro no dejó nada -->
                <controls:EmptyState
                    Grid.Row="1"
                    Glyph="&#xE721;"
                    Title="Ningún modelo coincide"
                    Message="Prueba con otra búsqueda o cambia el filtro."
                    ActionText="Quitar filtros"
                    ActionClick="QuitarFiltros_Click"
                    Visibility="{x:Bind ViewModel.SinResultados, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
