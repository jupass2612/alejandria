<Page
    x:Class="Alejandria.Views.DataBasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="DataBase (experimental)" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Todo lo que tiene que ver con la base de datos de Oracle de iMES — configurar modelos directo ahí, y revisar lo que ya hay registrado en cada tabla."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Configurar un modelo en iMES" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Da de alta un modelo directo en MODELS_PARENTS, MODELS_MASTER y MODELS_SERIALNUMBERSPECS — con opción de basarte en un registro ya existente en cada paso."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Abrir" Style="{ThemeResource AccentButtonStyle}" Click="ConfigurarEnImesButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <TextBlock Text="Ver lo ya registrado (solo lectura):" Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="MODELS_PARENTS" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Los modelos padre ya registrados (nombre, número de parte, familia)."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Ver" Click="VerParentsButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="MODELS_MASTER" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Los modelos ya registrados (nombre, números de parte, modelo padre, PCBs por panel, etc.)."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Ver" Click="VerMasterButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="MODELS_SERIALNUMBERSPECS" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Los segmentos de serial ya registrados por modelo (descripción, posición, longitud, valor fijo)."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="Ver" Click="VerSerialSpecsButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
