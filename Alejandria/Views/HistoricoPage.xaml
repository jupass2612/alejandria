<Page
    x:Class="Alejandria.Views.HistoricoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Alejandria.ViewModels"
    xmlns:controls="using:Alejandria.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Histórico" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Modelos con Estatus General Terminado (todas sus áreas completas). Se archivan aquí automáticamente y ya no se pueden editar ni volver a configurar — si cambió un número de parte, usa &quot;Actualizar&quot; para crear un modelo nuevo a partir de este."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            Margin="0,16,0,0"
            MaxWidth="420"
            HorizontalAlignment="Left"
            PlaceholderText="Buscar por nombre de modelo o número de parte (SMT/BE/TLA)..."
            TextChanged="SearchBox_TextChanged" />

        <InfoBar
            Grid.Row="2"
            Margin="0,16,0,0"
            Severity="Error"
            Title="Base de datos no disponible"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <ScrollViewer Grid.Row="3" Margin="0,16,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid
                    Grid.Row="0"
                    Padding="20,14"
                    ColumnSpacing="12"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Número de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Nombre de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Áreas" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Estatus General" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Fecha de solicitud" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="" />
                </Grid>

                <!-- Filas -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Modelos}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeloResumenItem">
                            <Grid Padding="20,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Modelo.NumeroModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Modelo.NombreModelo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Modelo.AreasAplicablesTexto}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Modelo.AreasAplicablesTexto}" />
                                <controls:StatusBadge Grid.Column="3" Status="{x:Bind EstatusGeneral}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Modelo.FechaSolicitudTexto}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        ToolTipService.ToolTip="Ver la configuración ya realizada, de solo lectura"
                                        Click="VerDetallesButton_Click"
                                        Tag="{x:Bind Modelo}">
                                        <TextBlock Text="Ver detalles" TextAlignment="Center" TextWrapping="Wrap" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        BorderBrush="{ThemeResource AppDangerBrush}"
                                        Foreground="{ThemeResource AppDangerBrush}"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{x:Bind NecesitaCorreccionDocumento, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="Este documento quedó marcado &quot;Pendiente a correcciones&quot; — sube la versión corregida"
                                        Click="AdjuntarPdfCorregidoButton_Click"
                                        Tag="{x:Bind Modelo}">
                                        <TextBlock Text="Adjuntar PDF" TextAlignment="Center" TextWrapping="Wrap" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        ToolTipService.ToolTip="Crear un modelo nuevo a partir de este, para actualizar el número de parte de un área"
                                        Click="ActualizarButton_Click"
                                        Tag="{x:Bind Modelo}">
                                        <TextBlock Text="Actualizar" TextAlignment="Center" TextWrapping="Wrap" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.MensajeVacio, Mode=OneWay}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="20,24,20,24"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.Modelos.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />
            </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
