<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Standard, low-emphasis action button used on cards -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Emphasized (accent) action button, used only once per view -->
    <Style x:Key="CardPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Navigation-item style with generous hit-target height -->
    <Style x:Key="NavItemIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!--
        Botones dentro de filas de tabla (Editar, Adjuntar/Ver/Reemplazar
        PDF, Configurar). Sin esto, el botón "por defecto" de WinUI usa un
        gris casi igual al fondo de la tarjeta en tema oscuro y se pierde
        visualmente contra la fila. El borde de acento + relleno sutil lo
        hacen notorio en los dos temas sin gritar tanto como un botón de
        acento sólido.
    -->
    <Style x:Key="TableRowActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
