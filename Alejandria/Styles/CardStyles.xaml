<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Botón normal de las tarjetas -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Botón principal, uno por pantalla -->
    <Style x:Key="CardPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Ícono del menú con más espacio para el clic -->
    <Style x:Key="NavItemIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Botones de las filas de tabla, con borde de acento para que se vean en tema oscuro -->
    <Style x:Key="TableRowActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
