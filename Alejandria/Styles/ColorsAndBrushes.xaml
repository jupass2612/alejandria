            <Color x:Key="AppBackgroundColor">#0F172A</Color>
            <Color x:Key="AppBorderColor">#334155</Color>
            <Color x:Key="AppDividerColor">#475569</Color>
            <Color x:Key="AppSuccessColor">#22C55E</Color>
            <Color x:Key="AppWarningColor">#FBBF24</Color>
            <Color x:Key="AppDangerColor">#F87171</Color>
            <Color x:Key="AppPendienteColor">#FACC15</Color>
            <Color x:Key="AppInfoColor">#38BDF8</Color>
            <Color x:Key="AppDisabledColor">#64748B</Color>
            <Color x:Key="AppSidebarBackgroundColor">#111827</Color>
            <Color x:Key="AppTextPrimaryColor">#F8FAFC</Color>
            <Color x:Key="AppTextSecondaryColor">#CBD5E1</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppPendienteBrush" Color="{StaticResource AppPendienteColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />
            <SolidColorBrush x:Key="AppDisabledBrush" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource AppSidebarBackgroundColor}" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource AppDividerColor}" />

            <Color x:Key="SystemAccentColor">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
            <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
            <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
            <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark3">#1E40AF</Color>

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />

            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource AppSurfaceColor}" />

            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#334155" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#475569" />

            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#334155" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#475569" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource AppBorderColor}" />

