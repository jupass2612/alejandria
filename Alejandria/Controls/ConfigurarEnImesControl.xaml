<UserControl
    x:Class="Alejandria.Controls.ConfigurarEnImesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Alejandria.Models"
    xmlns:viewmodels="using:Alejandria.ViewModels"
    mc:Ignorable="d">

    <StackPanel Spacing="20">

        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

        <!-- Paso 1: Parent -->
        <Border x:Name="Seccion1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="Paso 1 de 3 — Modelo padre (MODELS_PARENTS)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- Vista de completado -->
                <StackPanel x:Name="Paso1CompletadoPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="24" />
                    <StackPanel>
                        <TextBlock Text="Paso correctamente realizado" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="Paso1CompletadoDetalleText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Formulario (búsqueda/creación) -->
                <StackPanel x:Name="Paso1FormularioPanel" Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="¿Quién hizo este paso?" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox
                            x:Name="ResponsableParentCombo"
                            Grid.Column="1"
                            MinWidth="220"
                            ItemsSource="{x:Bind ViewModel.ResponsablesDisponibles}"
                            SelectedItem="{x:Bind ViewModel.ResponsableParent, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Nombre del modelo padre" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NombreParentBox" Grid.Column="0" PlaceholderText="Ej. Charge Port" Text="{x:Bind ViewModel.NombreParentBuscado, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Buscar parecidos" Click="BuscarParentsButton_Click" />
                        </Grid>
                    </StackPanel>

                    <ListView x:Name="ParentsListView" ItemsSource="{x:Bind ViewModel.ParentsSimilares}" SelectionMode="None" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ParentSimilarResult">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Parent.ParentModelName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Parent.PartNumber}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SimilitudTexto}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="2" Content="Usar este" Click="UsarParentButton_Click" Tag="{x:Bind Parent}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <TextBlock Text="O crea uno nuevo:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NuevoParentNombreBox" Grid.Column="0" Header="Nombre" Text="{x:Bind ViewModel.NuevoParent.ParentModelName, Mode=TwoWay}" />
                        <TextBox x:Name="NuevoParentPartNumberBox" Grid.Column="1" Header="Número de parte" Text="{x:Bind ViewModel.NuevoParent.PartNumber, Mode=TwoWay}" />
                    </Grid>
                    <TextBox x:Name="NuevoParentFamilyBox" Header="Familia" Text="{x:Bind ViewModel.NuevoParent.Family, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <CheckBox x:Name="ValidateFlowCheck" Content="Validate Flow" IsChecked="{x:Bind ViewModel.NuevoParent.ValidateFlow, Mode=TwoWay}" />
                        <CheckBox x:Name="ValidateLastOpCheck" Content="Validate Last Op Result" IsChecked="{x:Bind ViewModel.NuevoParent.ValidateLastOpResult, Mode=TwoWay}" />
                        <CheckBox x:Name="FlowFwdCheck" Content="Flow Fwd Validation" IsChecked="{x:Bind ViewModel.NuevoParent.FlowFwdValidation, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Content="Crear modelo padre" Click="CrearParentButton_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Paso 2: Master -->
        <Border x:Name="Seccion2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="Paso 2 de 3 — Modelo (MODELS_MASTER)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- Vista de completado -->
                <StackPanel x:Name="Paso2CompletadoPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="24" />
                    <StackPanel>
                        <TextBlock Text="Paso correctamente realizado" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="Paso2CompletadoDetalleText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Paso2FormularioPanel" Spacing="16">
                <TextBlock
                    x:Name="PistaTlaText"
                    Text="Este número de parte puede repetirse entre SMT/BE/TLA — para TLA, fíjate en cuál de los resultados trae &quot;TLA&quot; en el nombre."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <InfoBar
                    x:Name="SmtBeInfoBar"
                    Severity="Informational"
                    Title="Configurando SMT-BE"
                    Message="Este modelo tiene número de parte de SMT y de BE — van en el mismo MODELS_MASTER: SMT como número principal, BE en Número de parte 2, y &quot;(SMT-BE)&quot; en el nombre."
                    IsOpen="False"
                    IsClosable="False" />

                <StackPanel Spacing="8">
                    <TextBlock Text="Número de parte del modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NumeroParteBox" Grid.Column="0" PlaceholderText="Ej. 18010656-01" Text="{x:Bind ViewModel.NumeroDeParteBuscado, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Buscar por prefijo (8 caracteres)" Click="BuscarMastersButton_Click" />
                    </Grid>
                </StackPanel>

                <ListView x:Name="MastersListView" ItemsSource="{x:Bind ViewModel.MastersConPrefijoIgual}" SelectionMode="None" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImesMasterModel">
                            <Grid ColumnSpacing="12" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind ModelName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ModelPartNumber}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Basarme en este" Click="BasarseEnMasterButton_Click" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Content="Empezar desde cero (no basarse en ninguno)" Click="EmpezarDesdeCeroButton_Click" HorizontalAlignment="Left" />

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <TextBlock x:Name="MasterBaseText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                <TextBlock Text="Revisa (o completa) los datos antes de guardar:" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MasterNombreBox" Grid.Column="0" Header="Nombre del modelo" Text="{x:Bind ViewModel.NuevoMaster.ModelName, Mode=TwoWay}" />
                    <TextBox x:Name="MasterDescBox" Grid.Column="1" Header="Descripción" Text="{x:Bind ViewModel.NuevoMaster.ModelDesc, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MasterPartNumberBox" Grid.Column="0" Header="Número de parte (Model Part Number)" Text="{x:Bind ViewModel.NuevoMaster.ModelPartNumber, Mode=TwoWay}" />
                    <TextBox x:Name="MasterPartNumber2Box" Grid.Column="1" Header="Número de parte 2 (Model Part Number 2)" Text="{x:Bind ViewModel.NuevoMaster.ModelPartNumber2, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Modelo padre (PARENTMODELID)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox
                            x:Name="ParentModelIdCombo"
                            ItemsSource="{x:Bind ViewModel.TodosLosParents}"
                            DisplayMemberPath="ParentModelName"
                            PlaceholderText="Elige uno..."
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ParentModelIdCombo_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="PCBs por panel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="PcbsPerPanelBox" PlaceholderText="Vacío = sin definir (NULL)" TextChanged="PcbsPerPanelBox_TextChanged" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MasterQrBox" Grid.Column="0" Header="QR Part Number" Text="{x:Bind ViewModel.NuevoMaster.ModelQrPartNumber, Mode=TwoWay}" />
                    <TextBox x:Name="MasterProductIdBox" Grid.Column="1" Header="Product ID" Text="{x:Bind ViewModel.NuevoMaster.ModelProductId, Mode=TwoWay}" />
                    <TextBox x:Name="MasterFgPartNumberBox" Grid.Column="2" Header="FG Part Number" Text="{x:Bind ViewModel.NuevoMaster.FgPartNumber, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox x:Name="SimulateInterlockCheck" Content="Simulate Interlock" IsChecked="{x:Bind ViewModel.NuevoMaster.SimulateInterlock, Mode=TwoWay}" />
                    <CheckBox x:Name="ValidateInterlockCheck" Content="Validate Interlock" IsChecked="{x:Bind ViewModel.NuevoMaster.ValidateInterlock, Mode=TwoWay}" />
                    <CheckBox x:Name="SerialByMesCheck" Content="Serial Number by MES" IsChecked="{x:Bind ViewModel.NuevoMaster.SerialNumberByMes, Mode=TwoWay}" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="¿Quién hizo este paso?" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        x:Name="ResponsableMasterCombo"
                        Grid.Column="1"
                        MinWidth="220"
                        ItemsSource="{x:Bind ViewModel.ResponsablesDisponibles}"
                        SelectedItem="{x:Bind ViewModel.ResponsableMaster, Mode=TwoWay}" />
                </Grid>

                <Button Content="Guardar modelo" Click="GuardarMasterButton_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Paso 3: SerialNumberSpecs -->
        <Border x:Name="Seccion3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="Paso 3 de 3 — Segmentos del serial (MODELS_SERIALNUMBERSPECS)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- Vista de completado -->
                <StackPanel x:Name="Paso3CompletadoPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="24" />
                    <StackPanel>
                        <TextBlock Text="Paso correctamente realizado" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="Paso3CompletadoDetalleText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Paso3FormularioPanel" Spacing="16">
                <TextBlock x:Name="CopiarSpecsInfoText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                <Button x:Name="CopiarSpecsButton" Content="Copiar los segmentos del modelo base" Click="CopiarSpecsButton_Click" HorizontalAlignment="Left" Visibility="Collapsed" />

                <Rectangle x:Name="SeparadorCopiar" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed" />

                <StackPanel Spacing="8">
                    <TextBlock Text="O arma los segmentos a partir de un serial real de ejemplo" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Escribe un serial real (ej. 38375350-003-61830901), extráelo del PDF adjunto, o dale &quot;Empezar&quot; y ve marcando dónde termina cada pedazo, de izquierda a derecha."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SerialEjemploBox" Grid.Column="0" PlaceholderText="Ej. 38375350-003-61830901" Text="{x:Bind ViewModel.SerialEjemplo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Content="Extraer del PDF"
                            ToolTipService.ToolTip="Busca el &quot;Laser Serial Number real example&quot; en el PDF adjunto de este modelo y lo pone aquí (no lo prueba, solo lo extrae)"
                            Click="ExtraerSerialDelPdfButton_Click" />
                        <Button Grid.Column="2" Content="Empezar" Click="EmpezarSegmentacionButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- La cuadrícula de caracteres clickeables -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CeldasItemsControl" ItemsSource="{x:Bind ViewModel.Celdas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SerialCharacterCell">
                                <Button
                                    Padding="0"
                                    MinWidth="36"
                                    Height="52"
                                    Background="{x:Bind Fondo}"
                                    Click="Celda_Click"
                                    Tag="{x:Bind Position}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind DisplayChar}" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Position}" HorizontalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Mini formulario para etiquetar el pedazo que se acaba de marcar -->
                <Border x:Name="EtiquetarSegmentoBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="16" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="SegmentoPendienteText" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="EtiquetaCombo"
                                Grid.Column="0"
                                IsEditable="True"
                                PlaceholderText="¿Qué es este pedazo? (elige o escribe uno nuevo)"
                                ItemsSource="{x:Bind ViewModel.EtiquetasComunes}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="EsDinamicoCheck" Grid.Column="1" Content="Es dinámico (cambia por serial)" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Confirmar segmento" Style="{ThemeResource AccentButtonStyle}" Click="ConfirmarSegmentoButton_Click" />
                            <Button Content="Cancelar" Click="CancelarSegmentoButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="↩ Quitar el último segmento" Click="QuitarUltimoSegmentoButton_Click" HorizontalAlignment="Left" />

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <TextBlock Text="Segmentos confirmados (revisa antes de guardar):" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <ListView x:Name="SpecsListView" ItemsSource="{x:Bind ViewModel.SpecsNuevos}" SelectionMode="None">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VALUEDESCRIPTION" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="POSICIÓN" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="LONGITUD" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="DINÁMICO" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="VALOR FIJO" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImesSerialNumberSpec">
                            <Grid ColumnSpacing="8" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ValueDescription}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind StartPosition}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ExpectedCharacterLen}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind IsDynamicValue}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind FixedCharacterValue}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="¿Quién hizo este paso?" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        x:Name="ResponsableSpecsCombo"
                        Grid.Column="1"
                        MinWidth="220"
                        ItemsSource="{x:Bind ViewModel.ResponsablesDisponibles}"
                        SelectedItem="{x:Bind ViewModel.ResponsableSpecs, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <Button Content="Guardar segmentos" Click="GuardarSpecsButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>

                <InfoBar x:Name="TerminadoInfoBar" Severity="Success" Title="Guardado" Message="Se creó/actualizó en iMES." IsOpen="False" IsClosable="False" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
