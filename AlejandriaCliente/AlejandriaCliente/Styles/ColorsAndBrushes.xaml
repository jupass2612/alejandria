<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Estándar de diseño UI/UX del proyecto: Microsoft Fluent Design +
        Atlassian Design System. Los valores de color vienen tal cual del
        estándar (no son una simple inversión claro/oscuro — cada modo
        tiene su propia paleta calibrada).

        Se re-mapean aquí los tokens que YA usa WinUI/Fluent internamente
        (AccentFillColor*, TextFillColor*, CardBackgroundFillColor*, etc.)
        para que los controles nativos (botones, tarjetas, texto, inputs)
        adopten esta paleta automáticamente, sin tener que tocar cada XAML
        de la app uno por uno.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppAccentColor">#2563EB</Color>
            <Color x:Key="AppAccentHoverColor">#1D4ED8</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
            <Color x:Key="AppBorderColor">#E2E8F0</Color>
            <Color x:Key="AppDividerColor">#CBD5E1</Color>
            <Color x:Key="AppSuccessColor">#22C55E</Color>
            <Color x:Key="AppWarningColor">#F59E0B</Color>
            <Color x:Key="AppDangerColor">#EF4444</Color>
            <!-- No está en el estándar original: "En Proceso" ya usa el naranja de
                 Warning, así que "Pendientes" necesita su propio amarillo distinto
                 (misma escala Tailwind que el resto de la paleta). -->
            <Color x:Key="AppPendienteColor">#EAB308</Color>
            <Color x:Key="AppInfoColor">#0EA5E9</Color>
            <Color x:Key="AppDisabledColor">#94A3B8</Color>
            <Color x:Key="AppSidebarBackgroundColor">#FFFFFF</Color>
            <Color x:Key="AppTextPrimaryColor">#1E293B</Color>
            <Color x:Key="AppTextSecondaryColor">#64748B</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppPendienteBrush" Color="{StaticResource AppPendienteColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />
            <SolidColorBrush x:Key="AppDisabledBrush" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource AppSidebarBackgroundColor}" />

            <!-- Re-mapeo de tokens nativos de Fluent -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource AppDividerColor}" />

            <!--
                SystemAccentColor y sus variantes: MUCHOS controles nativos
                (NavigationView, ToggleSwitch, RadioButton, CheckBox, Slider,
                selección de texto, hipervínculos) leen esto directamente
                como Color, no como Brush — sin esto, esos controles seguían
                mostrando el color de acento del sistema operativo en vez del
                Primary del estándar. Escala tipo Tailwind (mismo origen que
                la paleta del estándar).
            -->
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
            <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>

            <!-- Fondo propio del panel de navegación (no usa CardBackgroundFillColor*) -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />

            <!-- Fondos de "capa" que usan NavigationView, Flyout, MenuFlyout, etc. -->
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource AppSurfaceColor}" />

            <!-- Hover/pressed neutro (botones, filas de lista, items de menú) -->
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#CBD5E1" />

            <!--
                Claves específicas que SÍ consumen directamente las plantillas
                de Button/ComboBox/TextBox. Los tokens de arriba
                (AccentFillColor*, ControlFillColor*, etc.) no bastan: varias
                plantillas de Fluent2 los referencian con StaticResource
                DENTRO de su propio diccionario base, así que un override
                nuestro más arriba en la cadena no siempre llega — por eso se
                repite aquí explícitamente para cada control.
            -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource AppBorderColor}" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="White" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="White" />

            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource AppTextSecondaryColor}" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AppAccentHoverColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- El modo oscuro NO es el claro invertido: tonos azul-grisáceos, nunca negro/blanco puro. -->
            <Color x:Key="AppAccentColor">#3B82F6</Color>
            <Color x:Key="AppAccentHoverColor">#60A5FA</Color>
            <Color x:Key="AppSurfaceColor">#1F2937</Color>
            <Color x:Key="AppBackgroundColor">#0F172A</Color>
            <Color x:Key="AppBorderColor">#334155</Color>
            <Color x:Key="AppDividerColor">#475569</Color>
            <Color x:Key="AppSuccessColor">#22C55E</Color>
            <Color x:Key="AppWarningColor">#FBBF24</Color>
            <Color x:Key="AppDangerColor">#F87171</Color>
            <Color x:Key="AppPendienteColor">#FACC15</Color>
            <Color x:Key="AppInfoColor">#38BDF8</Color>
            <Color x:Key="AppDisabledColor">#64748B</Color>
            <Color x:Key="AppSidebarBackgroundColor">#111827</Color>
            <Color x:Key="AppTextPrimaryColor">#F8FAFC</Color>
            <Color x:Key="AppTextSecondaryColor">#CBD5E1</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppPendienteBrush" Color="{StaticResource AppPendienteColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />
            <SolidColorBrush x:Key="AppDisabledBrush" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="{StaticResource AppSidebarBackgroundColor}" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource AppDividerColor}" />

            <Color x:Key="SystemAccentColor">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
            <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
            <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
            <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark3">#1E40AF</Color>

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppSidebarBackgroundColor}" />

            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource AppSurfaceColor}" />

            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#334155" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#475569" />

            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#334155" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#475569" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource AppBorderColor}" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource AppDisabledColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="White" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="White" />

            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource AppTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource AppTextSecondaryColor}" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AppAccentHoverColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Espaciado: sistema de 8px -->
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>
    <x:Double x:Key="Spacing40">40</x:Double>
    <x:Double x:Key="Spacing48">48</x:Double>
    <x:Double x:Key="Spacing64">64</x:Double>

    <!-- Radios: inputs/botones 8px, cards 12px, modales 12–16px -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ModalCornerRadius">14</CornerRadius>

    <!-- Re-mapeo de radios nativos: controles sin estilo propio (Button/TextBox/
         ComboBox por defecto) e overlays (ContentDialog/Flyout) heredan esto. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

    <!-- Tipografía: Inter es la preferida por el estándar: no viene incluida
         en Windows ni empaquetada en la app (evitamos incrustar una fuente
         sin poder probar que compile), así que se usa el reemplazo que el
         propio estándar autoriza explícitamente: Segoe UI. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

</ResourceDictionary>
