<Page
    x:Class="AlejandriaCliente.Views.TipoSolicitudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="560">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="Alejandría Cliente" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="¿Qué solicitud necesitas hacer?"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <Button
                Click="AltaDeModeloButton_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Alta de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                    <TextBlock
                        Text="Un modelo que todavía no existe en iMES/Unity — la solicitud completa."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Click="CambioDeFlujoButton_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Cambio de flujo" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                    <TextBlock
                        Text="Cambió la línea, el flujo de operaciones o las interfaces MES de un modelo existente (puede incluir números de parte de PCB/FG por separado)."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Click="CambioDeModeloButton_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Cambio de modelo" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" />
                    <TextBlock
                        Text="Modificar algo ya registrado de un modelo existente (nombre, números de parte, PCB/SAP, packout) — capturas lo Actual y lo Nuevo, sin tocar línea ni flujo."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button
                Click="VerHistorialButton_Click"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">
                Ver historial de solicitudes
            </Button>
        </StackPanel>
    </Grid>
</Page>
