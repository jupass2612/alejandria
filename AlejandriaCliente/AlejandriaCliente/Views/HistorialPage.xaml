<Page
    x:Class="AlejandriaCliente.Views.HistorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AlejandriaCliente.Models">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer Padding="32" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="20">

                <StackPanel Spacing="4">
                    <Button Content="&lt; Regresar" Click="RegresarButton_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <TextBlock Text="Historial de solicitudes" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Documentos generados en esta computadora. &quot;Editar&quot; vuelve a abrir el formulario ya lleno — al generar de nuevo, se reemplaza el mismo PDF."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Name="SinHistorialText"
                    Text="Todavía no has generado ninguna solicitud."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />

                <ListView x:Name="HistorialListView" SelectionMode="None" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistorialEntry">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20"
                                Margin="0,0,0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind NombreModelo}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind TipoTexto}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FechaTexto}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Ver PDF" Click="VerPdfButton_Click" Tag="{x:Bind}" />
                                        <Button Content="Editar" Click="EditarButton_Click" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Height="20" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
