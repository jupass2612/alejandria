<Page
    x:Class="AlejandriaCliente.Views.CambioDeFlujoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AlejandriaCliente.Models">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer Padding="32" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="20">

                <StackPanel Spacing="4">
                    <Button Content="&lt; Regresar" Click="RegresarButton_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <TextBlock Text="Cambio de flujo" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Para cuando cambia la línea, el flujo de operaciones o las interfaces MES de un modelo existente."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:Name="ResultadoInfoBar" IsOpen="False" IsClosable="True" />

                <!-- 1. Información General -->
                <Border x:Name="Seccion1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="1. General Information" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Request Date" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <DatePicker x:Name="FechaSolicitudPicker" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="Expected by" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <DatePicker x:Name="FechaEsperadaPicker" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Requestor Name" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="NombreSolicitanteBox" PlaceholderText="Ej. Daniel Treviño" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Text="Requestor Email" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="CorreoSolicitanteBox" PlaceholderText="Ej. daniel.trevino@bcs-ais.com" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Información del Modelo -->
                <Border x:Name="Seccion2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="2. Model Information" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Model Name" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="NombreModeloBox" PlaceholderText="Ej. Ford P833 SCCM" />
                        </StackPanel>
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="PCB Model SAP Part Number" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="PcbSapPartNumberBox" PlaceholderText="N/A si no aplica" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="FG Model SAP Part Number" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="FgSapPartNumberBox" PlaceholderText="N/A si no aplica" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="BCS Part Number" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="BcsPartNumberBox" PlaceholderText="Igual al SAP si es el mismo" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Client Part Number" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="ClientPartNumberBox" PlaceholderText="N/A si no aplica" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="PCB Laser Serial Number real example" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="PcbSerialBox" PlaceholderText="N/A si no aplica" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="FG Laser Serial Number real example" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="FgSerialBox" PlaceholderText="N/A si no aplica" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Información de línea -->
                <Border x:Name="Seccion3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="3. Line Information" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="LineasListView" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LineaInfo">
                                    <Grid ColumnSpacing="8" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" PlaceholderText="Line Name" Text="{x:Bind Nombre, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" PlaceholderText="PCB Side" Text="{x:Bind PcbSide, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" PlaceholderText="Efficiency" Text="{x:Bind Eficiencia, Mode=TwoWay}" />
                                        <TextBox Grid.Column="3" PlaceholderText="Cycle Time" Text="{x:Bind CycleTime, Mode=TwoWay}" />
                                        <TextBox Grid.Column="4" PlaceholderText="Full Rate" Text="{x:Bind FullRate, Mode=TwoWay}" />
                                        <TextBox Grid.Column="5" PlaceholderText="Expected Rate" Text="{x:Bind ExpectedRate, Mode=TwoWay}" />
                                        <Button Grid.Column="6" Content="Quitar" Click="QuitarLineaButton_Click" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="AgregarLineaButton" Content="+ Agregar línea" Click="AgregarLineaButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 4. Diagrama de flujo -->
                <Border x:Name="Seccion4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="4. Provide the model line flow diagram (operation by operation)" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Text="Adjunta la imagen de tu diagrama (una foto o captura de pantalla del dibujo a mano está bien) — se pega tal cual en el PDF."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AdjuntarDiagramaButton" Content="Adjuntar imagen" Click="AdjuntarDiagramaButton_Click" />
                            <TextBlock x:Name="DiagramaSeleccionadoText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ningún archivo seleccionado" />
                        </StackPanel>
                        <Image x:Name="DiagramaPreviewImage" MaxHeight="220" HorizontalAlignment="Left" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 5. Interfaces MES -->
                <Border x:Name="Seccion5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="5. By each operation, provide the current MES Interfaces available" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Text="Solo PCB o TLA flow."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="OperacionesListView" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OperacionInfo">
                                    <StackPanel Margin="0,6,0,6" Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" PlaceholderText="Op #" Text="{x:Bind Numero, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" PlaceholderText="Operation Name" Text="{x:Bind Nombre, Mode=TwoWay}" />
                                            <TextBox Grid.Column="2" PlaceholderText="Line Name" Text="{x:Bind LineaAsociada, Mode=TwoWay}" />
                                            <TextBox Grid.Column="3" PlaceholderText="MES Interface" Text="{x:Bind MesInterface, Mode=TwoWay}" />
                                            <Button Grid.Column="4" Content="Quitar" Click="QuitarOperacionButton_Click" Tag="{x:Bind}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <CheckBox Content="Requerida para Interlock Flow" IsChecked="{x:Bind RequeridaParaInterlock, Mode=TwoWay}" />
                                            <CheckBox Content="Tiene Interlock físico" IsChecked="{x:Bind TieneInterlockFisico, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="AgregarOperacionButton" Content="+ Agregar operación" Click="AgregarOperacionButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 6. Packout Setup Data (simple) -->
                <Border x:Name="Seccion6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="6. Packout Setup Data" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Finish Good or PCB Packout?" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="PackoutTipoCombo" HorizontalAlignment="Stretch">
                                    <x:String>FG</x:String>
                                    <x:String>PCB</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Last operation before Packout" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBox x:Name="UltimaOperacionBox" PlaceholderText="Ej. Op 860 Pin Alignment" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ValidarFlujoCheck" Content="Validate flow before Pack?" IsChecked="True" />
                        <StackPanel Spacing="6" MaxWidth="300">
                            <TextBlock Text="Box Label QR code" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="BoxLabelBox" PlaceholderText="N/A si no aplica" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 7. Aprobaciones -->
                <Border x:Name="Seccion7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="7. Approvals" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="AprobacionesListView" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AprobacionEntry">
                                    <Grid ColumnSpacing="16" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Rol}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" PlaceholderText="Nombre" Text="{x:Bind Nombre, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AtrasButton" Grid.Column="0" Content="&lt; Atrás" Click="AtrasButton_Click" />
                    <TextBlock x:Name="PasoActualText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="SiguienteButton" Grid.Column="2" Content="Siguiente &gt;" Style="{ThemeResource AccentButtonStyle}" Click="SiguienteButton_Click" />
                </Grid>

                <StackPanel Height="20" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
